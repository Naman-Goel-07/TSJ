# Supabase project settings — get these from your project's Settings > API page
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# !! NEVER add VITE_SUPABASE_SERVICE_ROLE_KEY here or anywhere in this project.
# !! The service_role key must not reach the browser. It belongs in Supabase secrets only.
